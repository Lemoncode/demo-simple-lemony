  "semantic": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{primitive.color.day.background}",
        "$description": "Fondo de página (cal blanca de día / mar de noche). shadcn `--background`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.background}"
          }
        }
      },
      "foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.foreground}",
        "$description": "Texto principal sobre `background`, `card`, `popover`, `muted` y `secondary` (≥13:1 en ambos temas).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.background}",
              "{semantic.color.card}",
              "{semantic.color.muted}",
              "{semantic.color.secondary}"
            ]
          }
        }
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.color.day.card}",
        "$description": "Tarjetas, panel de reserva, formularios elevados.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.card}"
          }
        }
      },
      "card-foreground": {
        "$type": "color",
        "$value": "{semantic.color.foreground}",
        "$description": "Texto sobre `card`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{semantic.color.foreground}"
          }
        }
      },
      "popover": {
        "$type": "color",
        "$value": "{primitive.color.day.popover}",
        "$description": "Popovers, selects, calendario desplegable, menús.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.popover}"
          }
        }
      },
      "popover-foreground": {
        "$type": "color",
        "$value": "{semantic.color.foreground}",
        "$description": "Texto sobre `popover`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{semantic.color.foreground}"
          }
        }
      },
      "primary": {
        "$type": "color",
        "$value": "{primitive.color.day.primary}",
        "$description": "Azul mar: acción principal (Reservar, Enviar), día seleccionado del calendario, enlaces. Como texto sobre `background` y `card` (5.8:1 / 8:1).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.primary}"
          },
          "com.lemony.contrast": [
            {
              "against": [
                "{semantic.color.background}",
                "{semantic.color.card}"
              ]
            },
            {
              "against": "{semantic.color.sea-soft}",
              "level": "non-text"
            }
          ]
        }
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.primary-foreground}",
        "$description": "Texto e iconos sobre un relleno `primary` (5.8:1 claro, 8:1 oscuro).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.primary-foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.primary}",
              "{semantic.color.primary-hover}"
            ]
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.color.day.secondary}",
        "$description": "Arena: botón secundario, chips de características, franjas de sección.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.secondary}"
          }
        }
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.secondary-foreground}",
        "$description": "Texto sobre `secondary`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.secondary-foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.secondary}"
            ]
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.color.day.muted}",
        "$description": "Fondos apagados: secciones alternas, inputs deshabilitados, skeletons.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.muted}"
          }
        }
      },
      "muted-foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.muted-foreground}",
        "$description": "Texto secundario, metadatos, placeholders; legible sobre `background`, `card` y `muted` (≥5.4:1).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.muted-foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.background}",
              "{semantic.color.card}",
              "{semantic.color.muted}"
            ]
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.color.day.accent}",
        "$description": "Bruma marina: hover de items de menú, opciones de select, ghost buttons.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.accent}"
          }
        }
      },
      "accent-foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.accent-foreground}",
        "$description": "Texto sobre `accent`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.accent-foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.accent}"
            ]
          }
        }
      },
      "destructive": {
        "$type": "color",
        "$value": "{primitive.color.day.destructive}",
        "$description": "Errores de formulario: borde de 2px del campo inválido, mensaje bajo el campo y resumen; como texto sobre `background`, `card` y `destructive-soft` (≥5.2:1 en ambos temas).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.destructive}"
          }
        }
      },
      "destructive-foreground": {
        "$type": "color",
        "$value": "{primitive.color.day.destructive-foreground}",
        "$description": "Texto sobre relleno `destructive`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.destructive-foreground}"
          },
          "com.lemony.contrast": {
            "against": [
              "{semantic.color.destructive}"
            ]
          }
        }
      },
      "destructive-soft": {
        "$type": "color",
        "$value": "{primitive.color.day.destructive-soft}",
        "$description": "Fondo del resumen de errores de un formulario, tras texto `destructive` (5.2:1 claro / 6:1 oscuro).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.destructive-soft}"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{primitive.color.day.border}",
        "$description": "Líneas divisorias y bordes de tarjeta (decorativo, no informativo).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.border}"
          }
        }
      },
      "input": {
        "$type": "color",
        "$value": "{primitive.color.day.input}",
        "$description": "Borde de inputs, checkboxes y selects (≥3:1 sobre `background` y `card`).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.input}"
          },
          "com.lemony.contrast": {
            "against": "{semantic.color.background}",
            "level": "non-text"
          }
        }
      },
      "ring": {
        "$type": "color",
        "$value": "{semantic.color.primary}",
        "$description": "Anillo de foco: 2px sólido + 2px de offset `background` (≥5.7:1).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{semantic.color.primary}"
          },
          "com.lemony.contrast": {
            "against": "{semantic.color.background}",
            "level": "non-text"
          }
        }
      },
      "sea": {
        "$type": "color",
        "$value": "{primitive.color.day.sea}",
        "$description": "Turquesa de la ilustración. Solo rellenos decorativos, iconos grandes y fondos de hero; NO para texto pequeño (3.8:1 en claro).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.sea}"
          }
        }
      },
      "sea-soft": {
        "$type": "color",
        "$value": "{primitive.color.day.sea-soft}",
        "$description": "Tinte marino: rango intermedio del calendario, banners informativos.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.sea-soft}"
          }
        }
      },
      "terracotta": {
        "$type": "color",
        "$value": "{primitive.color.day.terracotta}",
        "$description": "Teja: acentos cálidos, etiqueta de precio/oferta, día de hoy en el calendario, iconos de características. Como texto sobre `background` y `terracotta-soft`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.terracotta}"
          },
          "com.lemony.contrast": [
            {
              "against": [
                "{semantic.color.background}",
                "{semantic.color.card}"
              ]
            },
            {
              "against": "{semantic.color.terracotta-soft}",
              "level": "non-text"
            }
          ]
        }
      },
      "terracotta-soft": {
        "$type": "color",
