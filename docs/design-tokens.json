        "$description": "Fondo de badges y avisos cálidos tras texto `terracotta`.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.terracotta-soft}"
          }
        }
      },
      "on-terracotta": {
        "$type": "color",
        "$value": "{primitive.color.day.on-terracotta}",
        "$description": "Texto sobre relleno `terracotta` (5.3:1 / 7.3:1).",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.on-terracotta}"
          }
        }
      },
      "sun": {
        "$type": "color",
        "$value": "{primitive.color.day.sun}",
        "$description": "Sol del atardecer: estrellas de valoración, puntos de luz, ilustración. Nunca como fondo de texto blanco.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.sun}"
          }
        }
      },
      "sand": {
        "$type": "color",
        "$value": "{primitive.color.day.sand}",
        "$description": "Arena de la playa: bloques decorativos, separadores ilustrados.",
        "$extensions": {
          "com.lemony.modes": {
            "dark": "{primitive.color.dusk.sand}"
          }
        }
